# Google Gemini API Configuration
# Gemini API キーを設定してください
# 取得方法: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Development Configuration
# 開発環境用の設定
VITE_APP_ENV=development

# API Rate Limiting Configuration (オプション)
# デフォルト値: DAILY=200, MINUTE=8
VITE_DAILY_REQUEST_LIMIT=200
VITE_MINUTE_REQUEST_LIMIT=8

# セットアップ手順:
# 1. このファイルを .env.local にコピー
# 2. VITE_GEMINI_API_KEY に実際のAPIキーを設定
# 3. アプリケーションを再起動
