# さすらいのモモンガカーニバル - 環境変数設定例

# アプリケーション設定
VITE_APP_NAME="さすらいのモモンガカーニバル"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="モモンガくんと一緒に楽しむエンターテイメントサイト"

# API設定
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
VITE_API_BASE_URL="https://generativelanguage.googleapis.com"

# サイト設定
VITE_SITE_URL="https://sasurai-momonga-carnival.com"
VITE_SITE_DOMAIN="sasurai-momonga-carnival.com"

# 機能フラグ
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_DEBUG_MODE=false

# パフォーマンス設定
VITE_CACHE_VERSION="1.0.0"
VITE_MAX_FILE_SIZE="10485760" # 10MB in bytes

# セキュリティ設定
VITE_ENABLE_CSP=true
VITE_ENABLE_SECURITY_HEADERS=true

# PWA設定
VITE_ENABLE_PWA=true
VITE_PWA_CACHE_NAME="momonga-carnival-v1"

# 開発用設定
VITE_ENABLE_DEV_TOOLS=true
VITE_LOG_LEVEL="info"